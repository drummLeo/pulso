<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="br.local.pulso" android:versionCode="3" android:versionName="1.2">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="37"/>
    <queries>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
        <intent><action android:name="android.settings.SETTINGS"/></intent>
        <intent><action android:name="android.intent.action.DIAL"/><data android:scheme="tel"/></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/pulso" android:theme="@style/PulsoTheme"
        android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".FocusService" android:label="@string/service_name" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/focus_service"/>
        </service>
    </application>
</manifest>
