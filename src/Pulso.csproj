<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pulso</AssemblyName>
    <Version>1.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Pulso</Product>
    <Description>Sessões de foco e bloqueio de distrações no Windows</Description>
    <ApplicationIcon>pulso.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Pulso.Verificacao" />
    <EmbeddedResource Include="Browser/*" LogicalName="Pulso.Extension.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../shared/site_porn.txt;../shared/site_gambling.txt" LogicalName="Pulso.Extension.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../shared/app_categories.tsv" LogicalName="Pulso.AppCategories.tsv" />
    <Resource Include="pulso.ico" />
    <Resource Include="Browser/pulso.png" />
  </ItemGroup>
</Project>
