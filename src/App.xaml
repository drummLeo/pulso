<Application x:Class="Pulso.DesktopApp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="BodyFont">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Barlow, Bahnschrift, Segoe UI</FontFamily>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Canvas}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="ButtonFocus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Grid Margin="-2" IsHitTestVisible="False">
              <Border CornerRadius="9" BorderBrush="{DynamicResource Ink}" BorderThickness="2"/>
              <Border CornerRadius="8" BorderBrush="{DynamicResource Canvas}" BorderThickness="1" Margin="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Lilac}"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Face">
              <Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Border x:Name="Tint" CornerRadius="7" BorderBrush="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
              <Border Padding="{TemplateBinding BorderThickness}">
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource HoverTint}"/>
                <Setter TargetName="Tint" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource PressedTint}"/>
                <Setter TargetName="Tint" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Rail}"/>
      <Setter Property="Foreground" Value="{DynamicResource RailText}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,2"/>
      <Style.Triggers>
        <Trigger Property="Selector.IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource RailSelected}"/>
          <Setter Property="Foreground" Value="{DynamicResource RailSelectedText}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeroChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource HeroChipFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource HeroChipText}"/>
      <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="0,0,5,5"/>
      <Style.Triggers>
        <Trigger Property="Selector.IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedChipFill}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectedChipText}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
