<Window x:Class="Pulso.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pulso"
        Title="Pulso · Foco no PC" Icon="pulso.ico" Width="1030" Height="742" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Language="pt-BR" SizeChanged="ResizeShell" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Rail}">
      <DockPanel Margin="13,25,13,17" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="5,0,0,31">
            <Image Source="Browser/pulso.png" Width="39" Height="39" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="Wordmark" Text="Pulso" Foreground="{DynamicResource RailText}" FontSize="29" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" Margin="9,0,0,0"/>
          </StackPanel>
          <StackPanel x:Name="NavItems"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource RailLine}" Margin="7,0,7,11"/>
          <Button x:Name="ThemeButton" Style="{StaticResource RailButton}" Click="OpenThemeMenu" AutomationProperties.Name="Tema" ToolTip="Tema">
            <Button.ContextMenu>
              <ContextMenu Placement="Right" AutomationProperties.Name="Tema" MenuItem.Click="ChooseTheme">
                <MenuItem Header="Sistema" Tag="system" IsCheckable="True"/>
                <MenuItem Header="Claro" Tag="light" IsCheckable="True"/>
                <MenuItem Header="Escuro" Tag="dark" IsCheckable="True"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center"/>
              <TextBlock x:Name="ThemeLabel" Text="Tema" FontSize="13" Margin="5,0,0,0"/>
            </StackPanel>
          </Button>
          <StackPanel x:Name="BrowserNav"/>
          <TextBlock x:Name="RailState" Text="Aguardando extensão" FontSize="11" Foreground="{DynamicResource RailText}" Margin="15,5,0,2"/>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="PageFrame" Margin="30,27,30,27" MaxWidth="1100">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,21">
          <Border DockPanel.Dock="Right" Background="{DynamicResource Lilac}" CornerRadius="15" VerticalAlignment="Top" Padding="10,5" Margin="10,6,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource StatusIdle}"/>
              <TextBlock x:Name="StatusText" Text="Em espera" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
        <Border x:Name="NoticeBox" Grid.Row="1" CornerRadius="7" Background="{DynamicResource Lilac}" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Grid Grid.Row="2">
          <StackPanel x:Name="Home">
            <Border CornerRadius="17" Padding="23,17" Background="{DynamicResource HeroBackground}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,3,10,5">
                  <TextBlock x:Name="HeroTitle" Text="Foco rápido" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource HeroText}" FontSize="27" FontWeight="SemiBold"/>
                  <TextBlock x:Name="HeroHint" Foreground="{DynamicResource HeroMuted}" FontSize="14" Margin="0,5,0,14"/>
                  <WrapPanel x:Name="Presets">
                    <Button x:Name="P15" Style="{StaticResource HeroChip}" Content="15 min" Tag="15" Click="PresetClick"/>
                    <Button x:Name="P25" Style="{StaticResource HeroChip}" Content="25 min" Tag="25" Click="PresetClick"/>
                    <Button x:Name="P50" Style="{StaticResource HeroChip}" Content="50 min" Tag="50" Click="PresetClick"/>
                    <Button x:Name="PCustom" Style="{StaticResource HeroChip}" Content="Outro" Click="CustomMinutes"/>
                  </WrapPanel>
                  <Button x:Name="SessionButton" Click="ToggleSession" Background="{DynamicResource Mint}" Foreground="{DynamicResource OnMint}" HorizontalAlignment="Left" Padding="16,9" Margin="0,11,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ActionIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="ActionText" FontSize="14"/></StackPanel>
                  </Button>
                </StackPanel>
                <Grid x:Name="DialFrame" Grid.Column="1" Width="206" Height="206" VerticalAlignment="Center">
                  <local:FocusDial x:Name="Dial" IsHitTestVisible="False"/>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="25:00" FontSize="46" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource HeroText}"/>
                    <TextBlock x:Name="TimerLabel" Text="DURAÇÃO" TextAlignment="Center" Foreground="{DynamicResource HeroMuted}" FontSize="11" FontWeight="SemiBold"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            <Grid Margin="0,15,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Lista de bloqueio"/>
                  <TextBlock x:Name="HomeTargets" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
                  <TextBlock x:Name="HomeCoverage" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                  <Button Content="Editar lista" HorizontalAlignment="Left" Click="GoRules"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Foco de hoje"/>
                  <TextBlock x:Name="HomeMinutes" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
                  <TextBlock x:Name="HomeSessions" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                  <Button Content="Ver histórico" HorizontalAlignment="Left" Click="GoHistory"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,15,0,0" Padding="18,13">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Abrir agenda" Click="GoSchedule" Style="{StaticResource Quiet}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Próximo agendamento" FontWeight="SemiBold"/><TextBlock x:Name="HomeNext" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ContentPage" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
